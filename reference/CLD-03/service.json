{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "orders",
    "namespace": "shop"
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app": "orders",
      "track": "stable"
    },
    "ports": [
      {
        "name": "http",
        "port": 80,
        "targetPort": "http"
      }
    ]
  }
}
