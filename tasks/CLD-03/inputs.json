{
  "deployment": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "orders",
      "namespace": "shop"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app": "orders",
          "track": "stable"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "orders",
            "track": "stable"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "orders",
              "image": "example.invalid/orders:fixture",
              "ports": [
                {
                  "name": "http",
                  "containerPort": 8080
                }
              ]
            }
          ]
        }
      }
    }
  },
  "pods": [
    {
      "name": "orders-stable",
      "labels": {
        "app": "orders",
        "track": "stable"
      }
    },
    {
      "name": "orders-canary",
      "labels": {
        "app": "orders",
        "track": "canary"
      }
    },
    {
      "name": "billing-stable",
      "labels": {
        "app": "billing",
        "track": "stable"
      }
    }
  ]
}
